{
  "name": "@generacy-ai/agency-extension",
  "displayName": "Agency - AI Agent Development",
  "description": "FREE developer interface for Agency MCP server - configure plugins, test tools in-situ, monitor agent activity in real-time",
  "version": "0.1.0",
  "publisher": "generacy-ai",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#4A90E2",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/generacy-ai/agency",
    "directory": "packages/agency-extension"
  },
  "bugs": {
    "url": "https://github.com/generacy-ai/agency/issues"
  },
  "homepage": "https://github.com/generacy-ai/agency#readme",
  "qna": "https://github.com/generacy-ai/agency/discussions",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "agent",
    "ai agent",
    "generacy",
    "ai",
    "development",
    "devtools",
    "testing",
    "monitoring",
    "plugin",
    "docker",
    "devcontainer",
    "dev container"
  ],
  "activationEvents": [
    "workspaceContains:.agency/agency.config.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agency",
          "title": "Agency",
          "icon": "media/icons/agency.svg"
        }
      ]
    },
    "views": {
      "agency": [
        {
          "id": "agency.plugins",
          "name": "Plugins"
        },
        {
          "id": "agency.tools",
          "name": "Tools"
        },
        {
          "id": "agency.activity",
          "name": "Activity"
        },
        {
          "id": "agency.containers",
          "name": "Containers"
        },
        {
          "id": "agency.modes",
          "name": "Modes"
        },
        {
          "id": "agency.welcome",
          "name": "Getting Started",
          "when": "!config.agency.configExists"
        }
      ]
    },
    "commands": [
      {
        "command": "agency.configurePlugin",
        "title": "Configure Plugin",
        "category": "Agency"
      },
      {
        "command": "agency.enablePlugin",
        "title": "Enable Plugin",
        "category": "Agency",
        "icon": "$(check)"
      },
      {
        "command": "agency.disablePlugin",
        "title": "Disable Plugin",
        "category": "Agency",
        "icon": "$(x)"
      },
      {
        "command": "agency.refreshPlugins",
        "title": "Refresh Plugins",
        "category": "Agency",
        "icon": "$(refresh)"
      },
      {
        "command": "agency.testTool",
        "title": "Test Tool",
        "category": "Agency"
      },
      {
        "command": "agency.refreshTools",
        "title": "Refresh Tools",
        "category": "Agency"
      },
      {
        "command": "agency.connectMcp",
        "title": "Connect to MCP Server",
        "category": "Agency"
      },
      {
        "command": "agency.disconnectMcp",
        "title": "Disconnect from MCP Server",
        "category": "Agency"
      },
      {
        "command": "agency.switchMode",
        "title": "Switch Mode",
        "category": "Agency"
      },
      {
        "command": "agency.viewModeTools",
        "title": "View Mode Tools",
        "category": "Agency"
      },
      {
        "command": "agency.startContainer",
        "title": "Start Container",
        "category": "Agency"
      },
      {
        "command": "agency.stopContainer",
        "title": "Stop Container",
        "category": "Agency"
      },
      {
        "command": "agency.rebuildContainer",
        "title": "Rebuild Container",
        "category": "Agency"
      },
      {
        "command": "agency.viewContainerLogs",
        "title": "View Container Logs",
        "category": "Agency"
      },
      {
        "command": "agency.showMcpStatus",
        "title": "Show MCP Status",
        "category": "Agency"
      },
      {
        "command": "agency.showMcpError",
        "title": "Show MCP Error",
        "category": "Agency"
      },
      {
        "command": "agency.showContainerStatus",
        "title": "Show Container Status",
        "category": "Agency"
      },
      {
        "command": "agency.initConfig",
        "title": "Create Configuration",
        "category": "Agency"
      },
      {
        "command": "agency.showPlugins",
        "title": "Show Plugins",
        "category": "Agency"
      },
      {
        "command": "agency.openDocs",
        "title": "Open Documentation",
        "category": "Agency"
      }
    ],
    "configuration": {
      "title": "Agency",
      "properties": {
        "agency.configPath": {
          "type": "string",
          "default": ".agency/agency.config.json",
          "description": "Path to Agency configuration file"
        },
        "agency.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to MCP server on startup"
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "agency.configurePlugin",
          "when": "view == agency.plugins && viewItem =~ /^plugin/",
          "group": "navigation"
        },
        {
          "command": "agency.enablePlugin",
          "when": "view == agency.plugins && viewItem == pluginDisabled",
          "group": "inline"
        },
        {
          "command": "agency.disablePlugin",
          "when": "view == agency.plugins && viewItem == pluginEnabled",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "agency.refreshPlugins",
          "when": "view == agency.plugins",
          "group": "navigation"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "agency.gettingStarted",
        "title": "Get Started with Agency",
        "description": "Learn how to configure and use Agency for MCP development",
        "steps": [
          {
            "id": "createConfig",
            "title": "Create Configuration File",
            "description": "Create your first Agency configuration file to get started.\n[Create Configuration](command:agency.initConfig)",
            "media": {
              "markdown": "Get started by creating a configuration file that defines your MCP plugins and development environment."
            },
            "completionEvents": [
              "onCommand:agency.initConfig"
            ]
          },
          {
            "id": "configurePlugin",
            "title": "Configure First Plugin",
            "description": "Add and configure your first MCP plugin.\n[Browse Plugins](command:agency.showPlugins)",
            "media": {
              "markdown": "Browse available plugins and configure one to start testing MCP tools."
            },
            "completionEvents": [
              "onCommand:agency.configurePlugin"
            ]
          },
          {
            "id": "connectContainer",
            "title": "Connect to Container",
            "description": "Connect to a development container to test your plugins.\n[Connect to MCP](command:agency.connectMcp)",
            "media": {
              "markdown": "Connect to a container where your MCP plugins are running to start testing tools."
            },
            "completionEvents": [
              "onCommand:agency.connectMcp"
            ]
          },
          {
            "id": "testTool",
            "title": "Test a Tool",
            "description": "Test an MCP tool from your connected container.\n[View Tools](command:workbench.view.extension.agency)",
            "media": {
              "markdown": "Navigate to the Tools view and test a tool to see it in action."
            },
            "completionEvents": [
              "onCommand:agency.testTool"
            ]
          },
          {
            "id": "viewActivity",
            "title": "View Activity Feed",
            "description": "Monitor MCP activity and tool executions in real-time.\n[View Activity](command:workbench.view.extension.agency)",
            "media": {
              "markdown": "Check the Activity view to see tool executions, responses, and errors."
            },
            "completionEvents": []
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "execa": "^8.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
