    "url": "git+https://github.com/generacy-ai/agency.git",
    "directory": "packages/agency-plugin-spec-kit"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
