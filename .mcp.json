{
  "mcpServers": {
    "agency": {
      "type": "stdio",
      "command": "node",
      "args": ["/workspaces/agency/packages/agency/dist/cli.js"],
      "cwd": "/workspaces/agency"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    },
    "vscode-mcp-server": {
      "command": "npx",
      "args": ["mcp-remote@next", "http://localhost:3000/mcp", "--allow-http"]
    }
  }
}
